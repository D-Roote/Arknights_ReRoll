        "next": [
            "SReset_App_Stop"
        ]
    },
    "SReset_App_Stop": {
        "focus": "▶ 게임 종료",
        "action": {
            "type": "StopApp",
            "param": {
                "package": "com.YoStarKR.Arknights"
            }
        },
        "next": [
            "SReset_SharedPrefs_Export"
        ],
        "on_error": []
    },
    "SReset_SharedPrefs_Export": {
        "focus": "▶ 계정 shared_prefs 백업",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ExportArknightsSharedPrefs",
                "custom_action_param": {
                    "require_screenshot": true
                }
            }
        },
        "next": [
            "SReset_SharedPrefs_Delete"
        ],
        "on_error": []
    },
    "SReset_SharedPrefs_Delete": {
        "focus": "▶ 게임 shared_prefs 초기화",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DeleteArknightsSharedPrefs"
            }
        },
        "next": [
            "SReset_AdvertisingId_Reset"
        ],
        "on_error": []
    },
    "SReset_AdvertisingId_Reset": {
        "focus": "▶ Google 광고 ID 초기화",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ResetAdvertisingId"
            }
        },
        "next": [
            "SReset_App_Restart"
        ],
        "on_error": []
    },
    "SReset_App_Restart": {
        "focus": "▶ 게임 재실행",
