{
    "HReset_Start_Main": {
        "focus": "▶ 진행상황 초기화",
        "next": [
            "HReset_Start"
        ]
    },
    "HReset_Start": {
        "focus": "▶ 게임 종료",
        "action": {
            "type": "StopApp",
            "param": {
                "package": "com.YoStarKR.Arknights"
            }
        },
        "next": [
            "HReset_SharedPrefs_Delete"
        ],
        "on_error": []
    },
    "HReset_Restart": {
        "action": {
            "type": "StopApp",
            "param": {
                "package": "com.YoStarKR.Arknights"
            }
        },
        "post_delay": 10000,
        "next": [
            "HReset_App_Restart"
        ],
        "on_error": []
    },
    "HReset_SharedPrefs_Delete": {
        "focus": "▶ 게임 shared_prefs 초기화",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DeleteArknightsSharedPrefs"
            }
        },
        "next": [
            "HReset_AdvertisingId_Reset"
        ],
        "on_error": []
    },
    "HReset_AdvertisingId_Reset": {
        "focus": "▶ Google 광고 ID 초기화",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ResetAdvertisingId"
            }
        },
        "next": [
            "HReset_App_Restart"
        ],
        "on_error": []
    },
    "HReset_App_Restart": {
        "focus": "▶ 게임 재실행",
        "action": {
            "type": "StartApp",
            "param": {
                "package": "com.YoStarKR.Arknights"
            }
        },
        "next": [
            "HReset_ReDownload_Check"
        ],
        "on_error": [
            "HReset_Restart"
        ]
    },
    "HReset_ReDownload_Check": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "account/saved_reset/sr_download_nclick.png",
                "roi": [410, 265, 35, 123]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [432, 374, 1, 1]
            }
        },
        "next": [
            "HReset_ReDownload_Next",
            "HReset_ReDownload_Check"
        ],
        "on_error": [
            "HReset_Restart"
        ]
    },
    "HReset_ReDownload_Next": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "account/saved_reset/sr_download_clicked.png",
                "roi": [410, 265, 35, 123]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [766,442, 1, 1]
            }
        },
        "next": [
            "HReset_DownloadVoice_False",
            "HReset_No_DownloadVoice",
            "HReset_ReDownload_Check",
            "HReset_ReDownload_Next"
        ],
        "on_error": [
            "HReset_Restart"
        ]
    },
    "HReset_DownloadVoice_False": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "account/saved_reset/sr_download_check.png",
                "roi": [379, 37, 69, 482]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "HReset_No_DownloadVoice",
            "HReset_DownloadVoice_False"
        ],
        "on_error": [
            "HReset_Restart"
        ]
    },
    "HReset_No_DownloadVoice": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "account/saved_reset/sr_download_check.png",
                "roi": [379, 37, 69, 482]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [632, 596, 1, 1]
            }
        },
        "inverse": true,
        "next": [
            "[JumpBack]Login_Check_Before_Window",
            "HReset_Login_Check"
        ],
        "on_error": [
            "HReset_Restart"
        ]
    },
    "HReset_Login_Check": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "account/login/1_announcement.png",
                                "roi": [325, 486, 627, 123]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "account/login/2_already_login.png",
                                "roi": [1156, 287, 124, 238]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "account/login/4_login.png",
                                "roi": [509, 438, 260, 142]
                            }
                        }
                    }
                ]
            }
        },
        "next": [],
        "on_error": [
            "HReset_Restart"
        ]
    }
}