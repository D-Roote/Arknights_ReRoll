        ]
    },
    "SReset_ReDownload_Check": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "account/saved_reset/sr_download_nclick.png",
                "roi": [410, 265, 35, 123]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [432, 374, 1, 1]
            }
        },
        "next": [
            "SReset_ReDownload_Next",
            "SReset_ReDownload_Check"
        ]
    },
    "SReset_ReDownload_Next": {
        "recognition": {
            "type": "TemplateMatch",
